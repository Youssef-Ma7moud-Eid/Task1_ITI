------------------ Problem 5:Unique Characters--------------------------
int UniqueChar(String word) {
  Set<String> unique= word.split('').toSet();
  return unique.length;
}

void main() {
  print(UniqueChar('Youssef'));
}
 -----------------Problem 6: Product of Even Numbers--------------------------
void main() {
  List<int> numbers = [2, 3, 4,8];

  int product = numbers
      .where((n) => n % 2 == 0)
      .reduce((a, b) => a * b);

  print(product); 
}