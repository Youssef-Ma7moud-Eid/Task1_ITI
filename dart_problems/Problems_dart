--------------- Problem 1: Split and Join Characters---------
void split(String word) {
  String result = word
      .split('')
      .map((c) => c.toUpperCase())
      .join(',');
  print(result);
}

void main() {
  split('Youssef');
}
------------ Problem 2: Count Vowels in a String----------
void main() {
  String vowels = "aeiou";
  String word = 'Youssef';
  int count = word.split('').where((char) => vowels.contains(char)).length;

  print(count);
}
--------  Problem 3:Update Map Values-----------------
void main() {
  Map<String, int?> prices = {
    'apple': 20,
    'banana': null,
    'cherry': 5
  };

  prices.forEach((key, value) {
    prices[key] = (value ?? 0) + 10;
  });

  print(prices);
}
