## ================== Problem 5  ==================


int Check(int? param) {
  return param ?? 0;
}

void main() {
  print(Check(null));
  print(Check(4));
}
## ================== Problem 6  ==================
import 'dart:math';
int? generateRandom() {
  return Random().nextBool() ? 100 : null;
}

void main() {
  int status = generateRandom() ?? 0;
  print(status);
}
