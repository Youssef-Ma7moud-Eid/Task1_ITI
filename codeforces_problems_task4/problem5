using namespace std;


int main()
{
    int n;
    cin >> n;
    string s1;
    if (n % 2 == 0)
    {
        cout << "NO";
    }
    else {
        while (n)
        {
            if (n % 2 == 0)
            {
                s1.push_back('0');
            }
            else {
                s1.push_back('1');
            }
            n/=2;
        }
        string s2 = s1;
        reverse(s1.begin(), s1.end());
        if (s1 == s2)
        {
            cout << "YES";
        }
        else {

            cout << "NO";

        }
    }

    return 0;
}



   

