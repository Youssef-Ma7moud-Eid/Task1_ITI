#include <unordered_set>
#define  ll long long
# define joo ios_base::sync_with_stdio(false), cin.tie(nullptr), cout.tie(nullptr);
using namespace std;


int main()
{
    int n, a, b,sum=0;
    cin >> n >> a >> b;
    for (int i = 1; i <= n; i++)
    {
        int sum1 = 0;
        int num = i;
        while (num)
        {
            sum1 += (num % 10);
            num /= 10;
        }
        if (sum1 >= a && sum1 <= b)
        {
            sum += i;
      }
    }
    cout << sum;

    return 0;
}



   

