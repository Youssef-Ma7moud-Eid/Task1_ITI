#include <bits/stdc++.h>
#include <unordered_set>
#define  ll long long
# define joo ios_base::sync_with_stdio(false), cin.tie(nullptr), cout.tie(nullptr);
using namespace std;


int main()
{
    int n;
    cin >> n;
    for (int i = 2; i <= n; i++)
    {
        bool flag = true;
        for (int j = 2; j * j <= i; j++)
        {
            if (i % j == 0)
            {
                flag = false;
                break;
            }
        }
        if (flag)
        {
            cout << i << " ";
        }
    }

    return 0;
}



   

